{
  lib,
  writeShellScript,
  fetchFromGitHub,
  nix,
  nix-update,
  nodejs,
  buildNpmPackage,
  gnugrep,
  python3,
  coreutils,
  git,
}:
let
  pname = "mcpvault";

  # The upstream package-lock.json is generated by bun and omits `resolved` /
  # `integrity` for most entries (including zod, a runtime dependency of the
  # @modelcontextprotocol SDK). prefetch-npm-deps skips those, so `npm ci
  # --offline` fails with ENOTCACHED. Replace it with a fully-resolved lockfile
  # (regenerated via `npm install --package-lock-only`). This also runs inside
  # the fetchNpmDeps derivation (it inherits postPatch), keeping src and the
  # dependency cache consistent.
  packageLock = ./package-lock.json;

  updateScript = writeShellScript "mcpvault-update-script" ''
    export PATH=${lib.makeBinPath [
      nix
      nix-update
      nodejs
      gnugrep
      python3
      coreutils
      git
    ]}:$PATH
    ${builtins.readFile ./update.sh}
  '';
in
buildNpmPackage {
  inherit pname;
  version = "0-unstable-2026-08-22";
  src = fetchFromGitHub {
    owner = "bitbonsai";
    repo = pname;
    rev = "333b48c58f9446e6166e95bccffc60891b1a7ba1";
    sha256 = "sha256-dMVS4V7pzD8SHtclEnpiZvbjdW1OG0AqeTmALeG42LI=";
  };

  postPatch = ''
    cp ${packageLock} package-lock.json
  '';

  npmDepsFetcherVersion = 2;
  npmDepsHash = "sha256-hCo8g3771/z3R1ATe0/CmVWafddRx3h1gbwkJlNYSqg=";
  npmFlags = [ "--legacy-peer-deps" ];
  makeCacheWritable = true;

  passthru.updateScript = {
    command = updateScript;
    attrPath = "mcpvault";
  };

  meta = {
    description = "A lightweight Model Context Protocol (MCP) server for safe Obsidian vault access";
    homepage = "https://github.com/bitbonsai/mcp-obsidian";
    mainProgram = "mcp-obsidian";
    lisense = lib.licenses.mit;
    platforms = [
      "x86_64-linux"
      "aarch64-linux"
      "aarch64-darwin"
    ];
  };
}
